<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ArcaSim.Infrastructure\ArcaSim.Infrastructure.csproj" />
  </ItemGroup>

  <!-- ARCA's WSDL and XSD files travel next to the binary, folders included, so their relative imports resolve. -->
  <ItemGroup>
    <Content Include="..\..\docs\arca\wsdl\**\*.wsdl;..\..\docs\arca\wsdl\**\*.xsd" LinkBase="arca-wsdl" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\arca\servicios.json" Link="arca-servicios.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
